APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/webhook_engine
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis (Rate limiting only)
REDIS_URL=redis://localhost:6379/0

# Security & Cryptography
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace_with_valid_32_byte_url_safe_base64_fernet_key=
REQUIRE_HTTPS_ENDPOINTS=false

# Ingestion & Queue Settings
MAX_PAYLOAD_BYTES=262144
DEFAULT_MAX_ATTEMPTS=5
DEFAULT_RATE_LIMIT_PER_SEC=10
WORKER_BATCH_SIZE=50
WORKER_POLL_INTERVAL_SEC=0.5
SWEEPER_TIMEOUT_SEC=60
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_SEC=30